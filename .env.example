# Master Chef Configuration
# Server Port (auto-assigned by Render/Railway/Heroku/Fly.io if omitted)
PORT=3001

# Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini Model (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Node Environment ('production' for live deployments)
NODE_ENV=production
