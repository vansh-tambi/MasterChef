{
  "name": "master-chef",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"yellow.bold,cyan.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "node server/server.js",
    "preview": "npm run preview --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
